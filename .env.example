# このファイルを .env.local にコピーして値を設定してください（.env.local はコミット禁止）

# ログイン認証のID・パスワード
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# セッションCookieの署名鍵（`openssl rand -hex 32` で生成）
AUTH_SECRET=

# Google Sheets のCSVエクスポートURL（各シートの /export?format=csv&gid=... 形式。/edit URLでも自動変換されます）
SHEETS_MEMBERS_CSV_URL=
SHEETS_GOALS_CSV_URL=
SHEETS_LINKS_CSV_URL=

# Google Calendar の埋め込みURL（未設定なら日本の祝日カレンダーを仮表示）
GOOGLE_CALENDAR_EMBED_URL=
